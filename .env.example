DATABASE_URL=postgresql+psycopg://newstats:newstats@localhost:5432/newstats

# newstats/importer/flashscore.py's ingest_event/parse_kickoff take the
# scraping browser's timezone as an explicit source_tz argument, not an
# env var -- scripts/collect_*.py always pass "UTC" (they pin Playwright
# to timezone_id="UTC"), and a manual run of FlashscoreScraper's own CLI
# (which does NOT pin a timezone) needs the scraping host's own zone passed
# explicitly via ingest-event-cmd --source-tz. There is deliberately no
# global default to set here: a single process-wide timezone silently
# mismatched whichever call site wasn't using it (see git history / README
# "Известные ограничения" for the bug this replaced).
