DATABASE_URL=postgresql+psycopg://newstats:newstats@localhost:5432/newstats

# Directory the external scraper writes JSON fixtures/output into.
# The importer watches/reads this path; it never calls the scraper itself.
SCRAPER_OUTPUT_DIR=./data/scraper_output

# Timezone the scraping browser renders Flashscore's event["date"] in --
# NOT a property of Flashscore itself, it's whatever local time the browser
# that scraped the page was in (client-side JS). parse_kickoff() converts
# from this zone to UTC. Our own scraping host is Europe/Moscow; if you're
# running scripts/collect_*.py or FlashscoreScraper's own CLI from a
# different machine, set this to match it (or pin the scraper's browser
# context to timezone_id="UTC" and leave this at UTC).
SOURCE_TZ=Europe/Moscow
